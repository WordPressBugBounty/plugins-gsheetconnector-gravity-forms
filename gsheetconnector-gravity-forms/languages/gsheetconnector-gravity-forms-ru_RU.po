msgstr "ваш выбранный метод: "

msgid ""
"To start sending form entries to Google Sheets, please connect your Google account "
"first."
msgstr ""
"Чтобы начать отправку записей форм в Google Sheets, сначала подключите свою "
"учетную запись Google."

msgid "✔ Click on the Sign in with Google button"
msgstr "✔ Нажмите кнопку Войти с помощью Google"

msgid "✔ Log in using your Google account"
msgstr "✔ Войдите, используя свою учетную запись Google"

msgid "✔ Select the Google account where your Sheets are stored"
msgstr "✔ Выберите учетную запись Google, в которой хранятся ваши таблицы"

msgid "✔ Grant access to: Google Drive & Google Sheets"
msgstr "✔ Предоставьте доступ к: Google Drive и Google Sheets"

msgid "✔ Save the authentication code if prompted"
msgstr "✔ Сохраните код аутентификации, если будет предложено"

msgid "Go to Integration Setup"
msgstr "Перейти к настройке интеграции"

