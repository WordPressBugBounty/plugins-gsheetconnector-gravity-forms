msgstr "Rollenberechtigungen"

msgid "Administrator"
msgstr "Administrator"

msgid "Permission Guidelines"
msgstr "Berechtigungsrichtlinien"

msgid "Grant access only to users you trust"
msgstr "Gewähren Sie den Zugriff nur Benutzern, denen Sie vertrauen"

msgid "Existing Client / Secret Key (Auto Setup)."
msgstr "Vorhandener Client / Geheimschlüssel (Automatische Einrichtung)."

