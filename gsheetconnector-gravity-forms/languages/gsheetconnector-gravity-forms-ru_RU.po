msgstr "Конфигурация в один клик"

msgid "Real-time entry sync"
msgstr "Синхронизация записей в реальном времени"

msgid "Select Fields to Sync"
msgstr "Выберите поля для синхронизации"

msgid "Drag & drop field reordering"
msgstr "Перетаскивание и изменение порядка полей"

msgid "Rename column headers"
msgstr "Переименовать заголовки столбцов"

msgid "Select specific fields to sync"
msgstr "Выберите конкретные поля для синхронизации"

msgid "Header Settings &amp; Sheet Order"
msgstr "Настройки заголовка &amp; порядок листов"

msgid "Freeze header row"
msgstr "Закрепить строку заголовка"

msgid "Custom font styling"
msgstr "Настройка шрифта"

msgid "Header &amp; row color control"
msgstr "Управление цветом заголовка &amp; строки"

msgid "Sort by any column"
msgstr "Сортировать по любому столбцу"

msgid "Conditional Logic"
msgstr "Условная логика"

msgid "Show Features"
msgstr "Показать функции"

msgid "Hide Features"
msgstr "Скрыть функции"

