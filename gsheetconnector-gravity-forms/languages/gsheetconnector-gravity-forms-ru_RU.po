msgid "Apply rules based on form values"
msgstr "Применять правила на основе значений формы"

msgid "Sync data only when conditions match"
msgstr "Синхронизировать данные только при совпадении условий"

msgid "Filter unwanted or incomplete entries"
msgstr "Фильтровать нежелательные или неполные записи"

msgid "Create dynamic workflows automatically"
msgstr "Автоматически создавать динамические рабочие процессы"

msgid "Map data conditionally to sheet columns"
msgstr "Условно сопоставлять данные со столбцами таблицы"

msgid "Support multiple conditions (AND / OR)"
msgstr "Поддержка нескольких условий (AND / OR)"

msgid "Improve accuracy and reduce extra data"
msgstr "Повысить точность и уменьшить объём лишних данных"

