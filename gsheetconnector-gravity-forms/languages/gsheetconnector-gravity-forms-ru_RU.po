msgstr "Рекомендуется для тестовых сайтов"

msgid "Avoid enabling on live websites"
msgstr "Избегайте включения на живых сайтах"

msgid "Take backup before testing"
msgstr "Сделайте резервную копию перед тестированием"

msgid "Disable anytime if needed"
msgstr "Отключайте в любое время, если необходимо"

msgid "Update Control"
msgstr "Контроль обновлений"

